{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/*.js",
      "scripts/**/*.js",
      "!**/coverage",
      "!**/coverage-integration",
      "!**/dist",
      "!**/build",
      "!**/node_modules",
      "!**/generated",
      "!**/.yarn",
      "!**/.next",
      "!**/test-results",
      "!**/playwright-report",
      "!**/test/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 160
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noSvgWithoutTitle": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noUnknownAtRules": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useBlockStatements": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none"
    }
  },
  "overrides": [
    {
      "includes": ["src/app/**", "src/components/**", "src/lib/**", "!src/lib/api.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off",
            "noArrayIndexKey": "off"
          },
          "a11y": {
            "useSemanticElements": "off",
            "useAriaPropsSupportedByRole": "off"
          },
          "style": {
            "useBlockStatements": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
