#!groovy

// PINNED, and the pin is the only thing keeping AAT deployable. The library's `master` supplies
// `TF_VAR_jenkins_AAD_objectId` from a per-environment managed identity, which changes this server's Postgres
// Entra administrator from `jenkins-cftptl-intsvc-mi` to `jenkins-aat-mi`. `infrastructure/postgres.tf` passes
// that straight into `admin_user_object_id`, so the change forces a REPLACE of the administrator — and the
// `CanNotDelete` lock on `dts-github-metrics-data-aat` refuses the destroy half, failing `Apply … in aat` with
// a 409 ScopeLocked. This branch resolves the identity the way it was resolved before that change.
//
// Remove the pin once the platform has resolved the identity migration against the lock; the floating
// `Infrastructure` is what every other CFT service uses and what this should go back to.
@Library("Infrastructure@DTSPO-35113/master")

def type = "nodejs"
def product = "dtsse"
def component = "github-metrics"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

// The integration suite needs a real Postgres, so `before('test')` starts one on the agent — the pattern
// hwf-staffapp and the five et-pet repos already run on green masters. Two details are load-bearing:
//
//   - the image is the ACR mirror rather than Docker Hub, so the pull is not rate-limited, and the
//     `az acr login` has to happen inside the hook because a `before` hook runs OUTSIDE the pipeline's own
//     `withAcrClient` block;
//   - THE NAME AND THE PORT ARE BOTH PER-BUILD, and that is not tidiness. Two builds of this repository can
//     share one agent, and when they shared a container name each one's teardown destroyed the other's
//     database mid-suite — which surfaces as a stage timing out with no failing test, nothing like its cause.
//     The name is `BRANCH_NAME`-`BUILD_NUMBER` (`PR-54-3`, `master-58`), unique per build so a rerun cannot
//     collide with the run it replaced. Not `CHANGE_ID`: it is the pull-request number, but it is null on
//     master, which would put every master build back on one shared name. The port is whatever the daemon
//     assigns, read back below, because a fixed port collides even when the names are unique — and it is
//     published rather than shared because the agent image runs its own cluster on 5432.
def postgresImage = 'hmctsprod.azurecr.io/imported/postgres:16-alpine'
def buildRef = env.BRANCH_NAME == null ? null : "${env.BRANCH_NAME}-${env.BUILD_NUMBER}"
def postgresContainer = "metrics-test-postgres-${buildRef}".replaceAll('[^A-Za-z0-9_.-]', '-')

static Map<String, Object> secret(String secretName, String envVariable) {
  [
    $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    envVariable: envVariable
  ]
}

def secrets = [
  'dtsse-${env}': [
    secret('AppInsightsConnectionString', 'APPLICATIONINSIGHTS_CONNECTION_STRING')
  ]
]

withPipeline(type, product, component) {
  loadVaultSecrets(secrets)

  env.NODE_CONFIG_ENV = 'test'

  // ONE hook per stage name, however many things it does: `registerBefore` is a map put keyed on the stage, so a
  // second `before('test')` would silently replace this one rather than run alongside it.
  before('test') {
    yarnBuilder.yarn('db:generate')

    // The library invokes `lint`, `test` and `test:coverage` and never the typechecker, so until here nothing
    // typechecked `test/integration` or `test/e2e`. First because it is the cheapest of the three to fail on.
    yarnBuilder.yarn('typecheck')

    // FAILS RATHER THAN FALLING BACK. An unset `BRANCH_NAME` would leave the name a constant again — the exact
    // shape of the bug this replaced — and it would do so invisibly, because a single build in isolation passes
    // either way. Loud here beats two builds quietly destroying each other's database again.
    if (!buildRef) {
      error 'BRANCH_NAME is not set, so the integration Postgres container would not be unique to this build'
    }

    // No `docker stop` of a leftover container first: there is nothing to leave behind now the name is unique,
    // and removing that step is the point — it is what reached into another build.
    sh script: """
      set -e
      env AZURE_CONFIG_DIR=/opt/jenkins/.azure-nonprod az acr login --name hmctsprod --subscription DCD-CNP-PROD
      docker inspect ${postgresImage} > /dev/null 2>&1 || docker pull ${postgresImage}
      docker run --rm --name ${postgresContainer} --publish 0:5432 \
        -e POSTGRES_DB=github_metrics -e POSTGRES_USER=hmcts -e POSTGRES_HOST_AUTH_METHOD=trust \
        -d ${postgresImage}
      for attempt in \$(seq 1 30); do
        docker exec ${postgresContainer} pg_isready -U hmcts -d github_metrics && break
        sleep 2
      done
      docker exec ${postgresContainer} pg_isready -U hmcts -d github_metrics
    """, label: 'Start the integration-test Postgres'

    // The daemon chose the port, so ask it rather than assuming one. `docker port` prints one line per binding
    // (IPv4 and IPv6), hence the `head -1`.
    def postgresPort = sh(
      script: "docker port ${postgresContainer} 5432 | head -1 | sed 's/.*://'",
      returnStdout: true,
      label: 'Read the port the daemon assigned'
    ).trim()

    // Runs here rather than in its own stage because this is where the database is: the suite is the only gate
    // on `src/evidence/store/**` and `report/repositories.ts`, both of which the unit config exempts. It also
    // has to precede the sonar scan, which reads `coverage-integration/lcov.info`.
    withEnv(["DATABASE_URL=postgresql://hmcts@localhost:${postgresPort}/github_metrics"]) {
      yarnBuilder.yarn('db:migrate')
      yarnBuilder.yarn('test:integration')
    }
  }

  afterAlways('test') {
    sh script: "docker stop ${postgresContainer} && docker rm ${postgresContainer} || echo 'test postgres already gone'",
      label: 'Stop the integration-test Postgres'
  }

  onPR() {
    env.E2E_TEST_SCOPE = '@smoke'
    env.TEST_URL = "https://dtsse-github-metrics-pr-${CHANGE_ID}.preview.platform.hmcts.net"

    // A scrubbed copy of AAT's database replaces the PR's own before its smoke tests, and the PR's migrations are
    // applied on top of it — see `src/preview/load-aat.ts` for the order and the guards. PULL REQUESTS ONLY: master's
    // staging release reads the real AAT database, and this block is the only place the copy is reachable from.
    //
    // Three things the smoke stage does not provide, supplied here:
    //
    //   - CLUSTER ACCESS. The library runs this hook outside `withAksClient`, so it is entered here, and the
    //     credentials go to a kubeconfig of this build's own rather than the agent's shared one, which a concurrent
    //     build on the same agent can repoint at another cluster between two of our calls;
    //   - THE AAT CREDENTIALS, fetched for this hook alone rather than added to `secrets`, which would load
    //     production admin credentials into every stage of every build, master's included;
    //   - THE POSTGRES CLIENTS, from the same ACR mirror the integration tests use, because `pg_dump` refuses a server
    //     newer than itself and the agent's own client version is not ours to rely on.
    //
    // A failure fails the build. There is no fallback to the empty database: smoke tests passing on no data would
    // hide exactly what this exists to show.
    before('smoketest:preview') {
      def previewSubscription = new uk.gov.hmcts.contino.Subscription(env).previewName
      def previewEnvironment = new uk.gov.hmcts.contino.Environment(env).previewName
      def aksSubscription = new uk.gov.hmcts.pipeline.AKSSubscriptions(this).preview.name
      def copyDirectory = "${env.WORKSPACE_TMP ?: env.WORKSPACE + '@tmp'}/preview-aat-copy-${env.BUILD_NUMBER}"

      withAksClient(previewSubscription, previewEnvironment, product) {
        try {
          sh script: """
            set -e
            rm -rf '${copyDirectory}' && mkdir -p -m 700 '${copyDirectory}'
            env AZURE_CONFIG_DIR=/opt/jenkins/.azure-${previewSubscription} az aks get-credentials \
              --resource-group '${env.AKS_RESOURCE_GROUP}' --name '${env.AKS_CLUSTER_NAME}' \
              --subscription '${aksSubscription}' --admin --file '${copyDirectory}/kubeconfig' --overwrite-existing > /dev/null
            env AZURE_CONFIG_DIR=/opt/jenkins/.azure-nonprod az acr login --name hmctsprod --subscription DCD-CNP-PROD
            docker inspect ${postgresImage} > /dev/null 2>&1 || docker pull ${postgresImage}
          """, label: "Reach ${env.AKS_CLUSTER_NAME} and pull the Postgres clients"

          withAzureKeyvault(
            azureKeyVaultSecrets: [
              secret('github-metrics-postgres-host', 'AAT_POSTGRES_HOST'),
              secret('github-metrics-postgres-port', 'AAT_POSTGRES_PORT'),
              secret('github-metrics-postgres-user', 'AAT_POSTGRES_USER'),
              secret('github-metrics-postgres-password', 'AAT_POSTGRES_PASSWORD'),
              secret('github-metrics-postgres-database', 'AAT_POSTGRES_DATABASE')
            ],
            keyVaultURLOverride: 'https://dtsse-aat.vault.azure.net/',
            applicationIDOverride: env.AZURE_CLIENT_ID,
            applicationSecretOverride: env.AZURE_CLIENT_SECRET
          ) {
            withEnv(["KUBECONFIG=${copyDirectory}/kubeconfig", "PG_CLIENT_IMAGE=${postgresImage}", "TMPDIR=${copyDirectory}"]) {
              yarnBuilder.yarn('preview:load-aat')
            }
          }
        } finally {
          sh script: "rm -rf '${copyDirectory}'", label: 'Remove the kubeconfig and any dump left behind'
        }
      }
    }

    before('functionalTest:preview') {
      sh 'rm -rf playwright-report test-results'
    }
    afterAlways('smoketest:preview') {
      archivePlaywrightReport('Smoke Test Report')
    }
    afterAlways('functionalTest:preview') {
      archivePlaywrightReport('Functional Test Report')
    }
  }

  onMaster() {
    env.E2E_TEST_SCOPE = '@regression'
    env.TEST_URL = "https://dtsse-github-metrics.aat.platform.hmcts.net"

    afterAlways('functionalTest:aat') {
      archivePlaywrightReport('Functional Test Report')
    }
  }
}

def archivePlaywrightReport(String reportName) {
  try {
    publishHTML([
      allowMissing: true,
      alwaysLinkToLastBuild: true,
      keepAll: true,
      reportDir: 'playwright-report',
      reportFiles: 'index.html',
      reportName: reportName
    ])
  } catch (Error e) {
    unstable(message: "${STAGE_NAME} is unstable: " + e.toString())
  }
}
