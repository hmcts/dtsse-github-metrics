// Ported from `metrics.storage`, which kept two SQLite files with different lifecycles:
//
//   metrics.sqlite3               a disposable CACHE — deleting it costs only a refetch
//   metrics-observations.sqlite3  DURABLE state — alert history GitHub cannot be asked for again,
//                                 and a Sonar project map costing tens of minutes of paced calls
//
// One Postgres database holds both, so the boundary is no longer a file path. It survives as an
// invariant instead: `prune` may delete from the four cache tables and must never touch
// `alert_observations`, `sonar_project_map`, the six organisation-graph tables,
// `repository_production`, `repository_notes`, or `cve_scans` and `cve_findings`. That is enforced by
// test/integration/prune-never-touches-durable.test.ts, not by convention.
//
// `repository_notes` is durable for the strongest version of that reason and is the ONE TABLE THE WEB
// PROCESS WRITES. Everything else here is written by `collect` from a source that can be asked again;
// a note is prose a person typed, so a deleted row is recoverable from nobody.
//
// Facts are stored as `jsonb` payloads beside the few queryable columns, exactly as upstream stored
// `model_dump_json()` text, so adding a field to a fact needs no migration.

generator client {
  provider = "prisma-client-js"
  output   = "../src/evidence/store/generated"
}

// No `url` here: Prisma 7 rejects it in the schema. The connection string reaches Migrate through
// prisma.config.ts and the runtime client through the `PrismaPg` adapter in store/prisma.ts.
datasource db {
  provider = "postgresql"
}

// ─── Cache: prunable, safe to delete, refetchable ────────────────────────────────────────────────

/// The last observed state of a repository: metadata, merge gate, alerts, CODEOWNERS, maintenance,
/// Sonar. One row per repository — a collection replaces it rather than appending.
model RepositoryState {
  organization String
  repository   String
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(6)
  payload      Json     @db.JsonB

  @@id([organization, repository])
  @@map("repository_state")
}

/// Which intervals of which source have been collected, keyed by a hash of the GraphQL documents
/// that collected them. Widening a query changes the hash, which auto-invalidates the intervals
/// gathered by the narrower one — so a new field cannot be silently reported as absent.
///
/// `ends_at > starts_at` is enforced by a CHECK constraint added in the initial migration; Prisma has
/// no expression for it.
model SourceCoverage {
  organization String
  repository   String
  source       String
  queryHash    String   @map("query_hash")
  startsAt     DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(6)
  accessedAt   DateTime @map("accessed_at") @db.Timestamptz(6)

  @@id([organization, repository, source, queryHash, startsAt])
  @@index([accessedAt])
  @@map("source_coverage")
}

/// One merged pull request, as collected. `merged_at` is a column because windows are selected on it;
/// everything else lives in the payload.
///
/// THE PAYLOAD HOLDS NO `body` AND NO `title`. Both were stored and then projected away on every read, and
/// projecting a jsonb document still detoasts it to build the reduced one — measured on a seeded table of
/// this row count, the 26-week organisation-wide read cost 35,815 buffers with them and 1,900 without. What
/// the two metrics that grade a description need are PREDICATES over it, so `bodyLength` and
/// `hasTicketReference` are derived at collect time and stored instead. See `behaviour/collect.ts`.
model PullRequestFact {
  organization String
  repository   String
  queryHash    String   @map("query_hash")
  /// GitHub's own `databaseId`, which is a BIGINT and not an INTEGER: a real pcs-api pull request carries
  /// 3977105018, comfortably past a 32-bit signed maximum of 2147483647. Prisma's `Int` maps to `integer` and
  /// the insert was rejected outright — which is the good failure, but the column has to hold what GitHub sends.
  identifier   BigInt
  mergedAt     DateTime @map("merged_at") @db.Timestamptz(6)
  /// Who merged it, on exactly the criterion that makes `permission` a column on `org_team_repositories`: the
  /// ownership ladder runs this as a PREDICATE across every fact in the estate, so it is not a detail. Read
  /// out of the payload it cost 51,139 buffers over a 90-day window against 1,835 as a column, because
  /// `payload->>'authorLogin'` appears three times in that statement and each evaluation detoasts the whole
  /// document.
  ///
  /// NULL where GitHub matched the merge to no account at all — which is nobody, and not the same answer as
  /// an account whose login happens to be unreadable. Absent stays absent.
  authorLogin  String?  @map("author_login")
  payload      Json     @db.JsonB

  @@id([organization, repository, queryHash, identifier])
  @@index([organization, repository, queryHash, mergedAt])
  @@map("pull_request_facts")
}

/// A commit on the default branch with no associated pull request. Counted in the merge cohort
/// denominator, because a direct commit is a change that reached the branch without review.
model DirectCommitFact {
  organization String
  repository   String
  queryHash    String   @map("query_hash")
  sha          String
  committedAt  DateTime @map("committed_at") @db.Timestamptz(6)
  payload      Json     @db.JsonB

  @@id([organization, repository, queryHash, sha])
  @@index([organization, repository, queryHash, committedAt])
  @@map("direct_commit_facts")
}

// ─── Durable: never pruned ───────────────────────────────────────────────────────────────────────

/// Open-alert counts as they stood at each collection. Append-only and keyed by `fetched_at`, because
/// GitHub serves only the present: an alert closed since the last run cannot be asked about again, so
/// a deleted row is a hole in the history for ever.
model AlertObservation {
  organization String
  repository   String
  family       String
  fetchedAt    DateTime @map("fetched_at") @db.Timestamptz(6)
  payload      Json     @db.JsonB

  @@id([organization, repository, family, fetchedAt])
  @@map("alert_observations")
}

/// Which GitHub repository each SonarCloud project analyses, and how that was decided.
///
/// A row with `repository` null and a `detail` set is a REMEMBERED NEGATIVE — somebody paid the
/// quota to find out that this project could not be attributed, and storing the answer is what stops
/// the next run paying it again. The `(repository IS NULL) <> (detail IS NULL)` CHECK constraint in
/// the initial migration encodes that: exactly one of the two is always present.
model SonarProjectMap {
  sonarOrganization String    @map("sonar_organization")
  projectKey        String    @map("project_key")
  repository        String?
  analysisAt        DateTime? @map("analysis_at") @db.Timestamptz(6)
  revision          String?
  method            String?
  resolvedAt        DateTime  @map("resolved_at") @db.Timestamptz(6)
  detail            String?

  @@id([sonarOrganization, projectKey])
  @@map("sonar_project_map")
}

/// Replaces upstream's `source_stamp`, which invalidated the served report by `stat()`ing the two
/// SQLite files for `(mtime, size)`. There is no file here, so a collection stamps a row instead and
/// the report cache polls `revision` — cheap, and it works across processes, which matters now that
/// the collector is a CronJob in a different pod from the readers.
model CollectionState {
  id          Int      @id @default(1)
  revision    BigInt   @default(1)
  collectedAt DateTime @map("collected_at") @db.Timestamptz(6)

  @@map("collection_state")
}

/// Whether each repository is a production service, as far as a PERSON is concerned.
///
/// ONE ROW PER REPOSITORY, seeded from the organisation graph by `collect-org`, so marking a repository
/// is editing a column on a row that already exists rather than composing an insert. See
/// `store/production-override.ts` for the statement a person runs and why the seed cannot overwrite it.
///
/// `production` IS A TRI-STATE and is NOT change-versioned: `true` forces the badge on, `false` forces it
/// off, and NULL defers to the organisation's approvals list. `false` is the answer the list itself cannot
/// express a correction to — an override that can only add leaves no way to say the list is wrong — and
/// NULL is what keeps an UNREAD list unread rather than turning it into a confident `false`.
///
/// IT IS A TABLE OF ITS OWN AND NOT A COLUMN ON `OrgRepository`, which is change-versioned: a value set by
/// hand there is superseded and lost the next time a collected field moves. `pushedAt` above is the
/// non-digest column pattern, and it works because THE COLLECTOR writes it; this flag is written by a
/// person, so the same pattern does not transfer. `repository_state.payload` is out for the neighbouring
/// reason — `recordRepositoryState` replaces that document wholesale on every run.
///
/// DURABLE for a different reason from the tables above. Theirs is that GitHub serves only the present;
/// this one's is that GitHub was never asked — the flag came from a person, and nothing can recover it
/// but that person's memory. `prune` may not touch it, which
/// test/integration/prune-never-touches-durable.test.ts asserts rather than leaving to convention.
///
/// Both key columns are CASEFOLDED by CHECK constraint, so `(hmcts, PCS-API)` and `(hmcts, pcs-api)`
/// cannot both exist and answer for one repository twice. Reads fold the name they look up, as
/// `inventory/production.ts` folds the approvals list for the same reason: GitHub owner and repository
/// names are case-insensitive.
model RepositoryProduction {
  organization String
  repository   String
  /// `true` forces production on, `false` forces it off, NULL defers to the approvals list.
  production   Boolean?
  /// Who moved the flag — an email, or whatever identifies them to their colleagues. Optional: a tick that
  /// refuses to be recorded without a name is a tick nobody makes.
  markedBy     String?   @map("marked_by")
  /// When `production` was last moved, MAINTAINED BY A DATABASE TRIGGER and by nothing in this codebase.
  /// The trigger fires `BEFORE UPDATE` only when the flag actually changed, so a seeded row reads NULL —
  /// never marked — and correcting `reason` alone does not restamp a decision. Invisible from this schema,
  /// which is why it is stated here; see the migration `20260916120000_production_as_a_column`.
  markedAt     DateTime? @map("marked_at") @db.Timestamptz(6)
  /// Why the flag was moved. Optional, and no report reads it: it is there for the next person who asks.
  reason       String?

  @@id([organization, repository])
  @@map("repository_production")
}

/// A free-text note somebody left against a repository — the context that is not derivable from
/// GitHub, and the only table in this database the WEB process writes.
///
/// MANY ROWS PER REPOSITORY, unlike `repository_production` above it. A note is a remark and not a
/// setting, so a second one does not replace the first; the page lists them oldest first and reads as
/// a log.
///
/// WHO, AS TWO COLUMNS. `authorSubject` is the Entra subject claim and identifies a person for ever;
/// `authorName` is what they were called when they wrote it, which is what the page prints. A display
/// name changes and a subject does not, so storing only the name would let a note silently change
/// hands, and storing only the subject would print a GUID at a reader. Where `AUTH_DISABLED=true`
/// there is no session and both carry the anonymous author — a stated value, never a blank.
///
/// `createdAt` AND `updatedAt` ARE BOTH STAMPED BY THE DATABASE and by nothing in this codebase.
/// `createdAt` comes from the column default and is never written again; `updatedAt` starts equal to
/// it and is moved by a `BEFORE UPDATE` trigger, which is what makes "an edit preserves the author and
/// `createdAt`" a property of the table rather than a rule the editing statement has to remember. The
/// trigger is invisible from this schema, which is why it is stated here; see the migration
/// `20260922090000_repository_notes`.
///
/// The body is held to a stated length and refused blank by CHECK constraints in that same migration.
/// `NOTE_BODY_LIMIT` in `src/lib/notes.ts` carries the same number so the form can say so.
model RepositoryNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization   String
  repository     String
  body           String
  authorSubject  String   @map("author_subject")
  authorName     String   @map("author_name")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  /// The one read this table serves: one repository's notes in the order they were written.
  @@index([organization, repository, createdAt])
  @@map("repository_notes")
}

/// That a CVE scan was PUBLISHED for one repository in one language, which is the fact the counts are
/// meaningless without.
///
/// THIS TABLE IS WHAT SEPARATES ZERO FROM UNMEASURED, and that is the whole reason it is a table rather
/// than a derived `COUNT(*) > 0` over `cve_findings`. Only three CNP builders publish a CVE report —
/// `YarnBuilder`, `GradleBuilder` and `PythonBuilder` — so 361 repositories have one against an estate of
/// about 1,890. A row here with no findings beside it is a scan that ran and found nothing; NO ROW is a
/// repository the security stage has never scanned. Counting findings alone cannot tell those apart, and
/// collapsing them would report four repositories in five as clean.
///
/// ONE ROW PER `(organization, repository, codebase_type)` and not per build. The container holds 762,779
/// documents describing those 361 repositories, one per build; what a dashboard reports is the current
/// position, so a newer report REPLACES this row and its findings rather than appending. A repository
/// publishing both a `java` and a `node` report has two rows, because neither supersedes the other.
///
/// `reported_at` IS THE DOCUMENT'S OWN `_ts` AND NOT WHEN IT WAS READ. It is what makes the write
/// idempotent — an older report cannot overwrite a newer one — and `MAX(reported_at)` per
/// `source_database` is the incremental watermark, which is why the collection needs no table of its own
/// to remember where it got to. A watermark stored apart from the rows can advance without them.
///
/// `source_database` records WHICH of the two Cosmos databases answered, because
/// `CosmosDbTargetResolver` routes by GitHub topic and the watermarks are therefore per database. IT IS NOT
/// PART OF THE KEY, and that is deliberate: 10 repository-language pairs have reports in BOTH containers,
/// having gained the `jenkins-sds` topic partway through their life, so keying by database would give one
/// repository two answers and let a stale history outrank its own present. One repository is one answer and
/// the newest report wins. The consequence is that a row can change hands, which can move a watermark
/// backwards — harmless, because re-reading a document folds to the same scan.
///
/// DURABLE, and for a reason unlike the other durable tables'. Cosmos still holds the documents, so this
/// is refetchable in principle — but deleting a row makes a repository that has not built since read
/// UNMEASURED when it was measured, which is the one answer this feature exists to get right. `prune` may
/// not touch it, asserted by test/integration/prune-never-touches-durable.test.ts.
///
/// Both key columns are CASEFOLDED by CHECK constraint, as `repository_production`'s are and for the same
/// reason twice over: GitHub names are case-insensitive, and the only name available here is parsed out of
/// `build.git_url`, which spells the owner `HMCTS` on every single document.
model CveScan {
  organization   String
  repository     String
  /// `java`, `node` or `python` — `build.codebase_type`, which is which builder published the report.
  codebaseType   String   @map("codebase_type")
  /// `jenkins` or `sds-jenkins`. Also the watermark key: the two databases are read independently.
  sourceDatabase String   @map("source_database")
  reportedAt     DateTime @map("reported_at") @db.Timestamptz(6)
  /// Jenkins' own `build_tag`, so a figure can be traced to the build that produced it.
  buildTag       String?  @map("build_tag")
  /// When the collection read it, which is not when the scan ran. Both, because a stale report and a
  /// stale collection are different problems and only the pair tells them apart.
  collectedAt    DateTime @map("collected_at") @db.Timestamptz(6)
  /// Declared so Prisma emits the foreign key rather than leaving it hand-written: a finding with no scan
  /// row would be a count for a repository that reads as never scanned, which is the one inconsistency
  /// that makes the absent-versus-zero rule unenforceable. `Cascade` is what lets a writer replace a
  /// repository's findings by replacing its scan row.
  findings       CveFinding[]

  @@id([organization, repository, codebaseType])
  @@index([sourceDatabase, reportedAt])
  @@map("cve_scans")
}

/// One CVE against one package, as the latest scan of one repository found it.
///
/// THE GRAIN IS FINE ON PURPOSE. Counting by severity is then a query rather than a stored aggregate that
/// goes stale the moment the severity vocabulary or the suppressed/live split is reported differently.
///
/// `severity` IS NULLABLE AND NULL IS NOT `low`. uv audit states no severity for any finding, and yarn
/// audit leaves it null on 51,359 of 462,521 live `master` findings — so a default would silently grade
/// an eighth of the node estate and the whole of the Python estate as the least serious band. The report
/// layer counts these in an `unknown` bucket, which is a bucket and never a column value.
///
/// `suppressed` IS PART OF THE PRIMARY KEY, not a column beside it, which is what makes "suppressed does
/// not inflate the live figure" structural: the two are different rows, so no count can accidentally
/// include both. dependency-check moves a suppressed finding out of `vulnerabilities` into
/// `suppressedVulnerabilities`, so in practice one CVE is one or the other and never both.
///
/// `package` IS IN THE KEY because one CVE affects several packages in one report, and the same CVE
/// against two different jars is two findings a reader would expect to see counted twice.
model CveFinding {
  organization String
  repository   String
  codebaseType String   @map("codebase_type")
  /// `CVE-2025-7962`, a GHSA identifier, or the advisory URL for an advisory with no CVE assigned.
  identifier   String
  /// The artefact or module the finding is against, in the scanner's own spelling.
  packageName  String   @map("package")
  suppressed   Boolean
  /// NULL where the report stated no severity. Absent stays absent.
  severity     String?
  /// The CVSS base score where the report carried one. Stored because it is free; read by nothing yet.
  score        Float?
  /// Why the suppression was accepted, where whoever wrote it said.
  ///
  /// THE MOST USEFUL COLUMN HERE, and the reason is what it lets a reader distinguish. A suppression with
  /// "HDPI-8150: temporary. … no fixed release published upstream yet. The risk vector (build-cache
  /// deserialization) is irrelevant to PCS's runtime" is sound engineering with a ticket behind it; one with
  /// nothing is a silent risk acceptance. Being able to tell them apart is the difference between a figure that
  /// helps a team and one that only shames it.
  ///
  /// NULL IS TWO DIFFERENT ANSWERS and `codebase_type` is what separates them. Only dependency-check has a
  /// `notes` field at all: no node document in either database carries `notes`, `justification`, `reason` or
  /// `comment` on a suppression, so NULL on a `node` row means the builder cannot record one, while NULL on a
  /// `java` row means nobody did. `recordsSuppressionNotes` in `domain/cves.ts` holds that rule, and the report
  /// layer leaves both documentation figures ABSENT rather than reporting zero where nothing could be assessed.
  ///
  /// Blank is stored as NULL. dependency-check emits `notes: ""` on every LIVE finding, and a blank string that
  /// justifies nothing should not be distinguishable from no string at all.
  notes        String?
  scan         CveScan  @relation(fields: [organization, repository, codebaseType], references: [organization, repository, codebaseType], onDelete: Cascade)

  @@id([organization, repository, codebaseType, identifier, packageName, suppressed])
  @@index([organization, repository])
  @@map("cve_findings")
}

// ─── Durable: the organisation graph, never pruned ───────────────────────────────────────────────
//
// Six tables holding who the teams are, who is in them, what they own, and what the ownership ladder
// decided. All six are DURABLE for `alert_observations`' exact reason: GitHub serves only the present.
// A membership deleted this morning cannot be asked about again, so nobody can put a question to
// GitHub about who was in `civil-admins` last June — a deleted row here is a hole in the history for
// ever. `prune` therefore may not touch them, which is asserted by
// test/integration/prune-never-touches-durable.test.ts rather than left to convention.
//
// Every one is CHANGE-VERSIONED (SCD-2) rather than snapshotted per run. Each row carries the closed
// or open interval over which one fact stayed true:
//
//   observed_at       when this fact first became true. IN THE PRIMARY KEY, so a fact that comes back
//                     after being superseded is a second interval and not an overwrite.
//   last_observed_at  the most recent run that saw it unchanged
//   superseded_at     when it stopped being true; NULL means live
//   digest            a hash of the varying content, so "unchanged" is one comparison
//
// A snapshot per run would multiply 3,277 repositories and 336 teams by every weekly collection to
// re-record an estate that barely moves. Here an unchanged run touches `last_observed_at` and writes
// no rows at all; only a change costs one.
//
// Reads are always `WHERE superseded_at IS NULL`, which the per-table partial unique indexes in the
// org-graph migration make sound — Prisma has no schema expression for a partial unique index, so
// those live in hand-written SQL, as do the `superseded_at > observed_at` CHECK constraints.

/// One GitHub team as the organisation listed it, over the interval that listing held.
///
/// `parent_slug` is a COLUMN and not part of the payload because ownership rollup walks it: teams nest,
/// and answering "what does this team's subtree hold" means following the parent edge repeatedly. Across
/// 336 nested teams, doing that through jsonb documents is a scan and not a query.
///
/// `name`, `description` and `privacy` stay in the payload — nothing selects on them.
model OrgTeam {
  organization   String
  teamSlug       String    @map("team_slug")
  parentSlug     String?   @map("parent_slug")
  payload        Json      @db.JsonB
  observedAt     DateTime  @map("observed_at") @db.Timestamptz(6)
  lastObservedAt DateTime  @map("last_observed_at") @db.Timestamptz(6)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz(6)
  digest         String

  @@id([organization, teamSlug, observedAt])
  @@map("org_teams")
}

/// One person's membership of one team, over the interval they held that role in it.
///
/// NO SECONDARY INDEX. Nothing queries this table by login: the `_live` partial unique below answers the
/// reconcile path, and the one reader — `liveOrgTeamMemberships`, which feeds each team page's Members
/// section — takes every live row for the organisation in one scan and groups them in memory, so "which
/// teams is this person in" is still a question nothing asks the database. A `(organization, login,
/// superseded_at)` index for it was maintained on every insert of all six reconciles and chosen by no plan;
/// it belongs here again when something asks.
///
/// COLLECTED WITH `membership: IMMEDIATE`, NOT GitHub's default of `ALL`. `ALL` folds every descendant
/// team's people into the parent, which across 336 nested teams makes a parent look as though it employs
/// its whole subtree, and makes "which teams is this person in" answer with the ancestry of the one team
/// they actually joined rather than that team. The rollup is a DERIVATION a reader may compute by walking
/// `org_teams.parent_slug`; it is not a fact, and storing it here would record an edge nobody made.
model OrgTeamMembership {
  organization   String
  teamSlug       String    @map("team_slug")
  login          String
  /// `MEMBER` or `MAINTAINER`, as GitHub words it.
  role           String
  observedAt     DateTime  @map("observed_at") @db.Timestamptz(6)
  lastObservedAt DateTime  @map("last_observed_at") @db.Timestamptz(6)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz(6)
  digest         String

  @@id([organization, teamSlug, login, observedAt])
  @@map("org_team_memberships")
}

/// One team's access to one repository, over the interval that access held.
///
/// `permission` is a column rather than payload because it is the first rungs of the ownership ladder:
/// `admin` and `maintain` are ownership, `push` is contested, and `triage`/`pull` are permission to look.
/// That comparison runs across every edge in the estate every time ownership is resolved, so it is a
/// predicate and not a detail.
model OrgTeamRepository {
  organization   String
  teamSlug       String    @map("team_slug")
  repository     String
  /// One of `AccessLevels` in org/graph.ts, whose ORDER is the semantics.
  permission     String
  observedAt     DateTime  @map("observed_at") @db.Timestamptz(6)
  lastObservedAt DateTime  @map("last_observed_at") @db.Timestamptz(6)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz(6)
  digest         String

  @@id([organization, teamSlug, repository, observedAt])
  @@map("org_team_repositories")
}

/// Every repository the organisation holds, whether any team holds it or not.
///
/// THIS TABLE IS WHAT MAKES "UNOWNED" ANSWERABLE. Ownership resolved from team edges alone can only
/// report repositories that have an owner; the 3,277 the organisation holds are the denominator, and
/// without them "how many does nobody own" has no numerator to subtract from.
///
/// `archived` and `visibility` are columns because they QUALIFY THE FINDING rather than decorate it: an
/// archived unowned repository is housekeeping, and a live public one is not. `is_fork` and the default
/// branch NAME stay in the payload; the two dates are columns, for the reasons each carries below.
model OrgRepository {
  organization             String
  repository               String
  archived                 Boolean
  visibility               String
  /// When the repository was last pushed to, ON ANY REF. CURRENT STATE, NOT A VERSIONED FACT — see below.
  ///
  /// Stored as a column and deliberately kept OUT of `digest`, which is what lets the cohort's activity
  /// window read it without the cost the writer's comment warns about: it moves on every push, so versioning
  /// on it would supersede and re-insert every active repository in the estate on every run. Updated in place
  /// beside `last_observed_at` instead, so a push changes this row rather than ending it and opening another.
  ///
  /// WHAT THE COHORT DECIDES FROM and not what the repositories list prints — a push to a feature branch moves
  /// it, so it answers "is anybody working in here" rather than "how current is the default branch". The column
  /// below answers that one.
  ///
  /// Nullable because GitHub omits it for a repository that has never been pushed to, and an absent last push
  /// is not the same answer as a very old one.
  pushedAt                 DateTime? @map("pushed_at") @db.Timestamptz(6)
  /// When the tip of the DEFAULT BRANCH was last committed to. CURRENT STATE, NOT A VERSIONED FACT.
  ///
  /// A SECOND DATE BECAUSE THERE ARE TWO QUESTIONS, and conflating them is the defect this column was added
  /// for: `pushed_at` moves on a push to any ref, so a repository with one busy feature branch reads as pushed
  /// to today while its default branch has not moved in a month. This column is what the repositories list
  /// prints. Neither is the other's fallback, which is why they are not one column with a changed meaning.
  ///
  /// Out of `digest` and updated in place for `pushed_at`'s reason exactly — it moves on every merge to the
  /// default branch, and versioning it would write a row per active repository per run.
  ///
  /// Nullable because GitHub omits the default branch ref for an empty repository, and because every row
  /// collected before this column existed carries NULL until the next `collect-org` run. Readers must render
  /// both as unmeasured rather than as a date.
  defaultBranchCommittedAt DateTime? @map("default_branch_committed_at") @db.Timestamptz(6)
  payload                  Json      @db.JsonB
  observedAt               DateTime  @map("observed_at") @db.Timestamptz(6)
  lastObservedAt           DateTime  @map("last_observed_at") @db.Timestamptz(6)
  supersededAt             DateTime? @map("superseded_at") @db.Timestamptz(6)
  digest                   String

  @@id([organization, repository, observedAt])
  @@map("org_repositories")
}

/// One organisation member, over the interval their membership and role held.
///
/// `role` is a column — `ADMIN` reads differently from `MEMBER` on every row that mentions the person.
/// `name`, `email` and `company` live in the payload because all three are SELF-REPORTED and frequently
/// blank, and `email` is the account's PUBLIC email: absent for most HMCTS members, and not their work
/// address when it is present. None of the three is an identity; the login is.
///
/// Keyed on `(organization, login)` like every other table here even though a GitHub account is not
/// org-scoped. What was observed is not the account — it is this person's MEMBERSHIP OF THIS
/// ORGANISATION, which begins, changes role, and ends.
model OrgPerson {
  organization   String
  login          String
  /// `ADMIN` or `MEMBER`.
  role           String
  payload        Json      @db.JsonB
  observedAt     DateTime  @map("observed_at") @db.Timestamptz(6)
  lastObservedAt DateTime  @map("last_observed_at") @db.Timestamptz(6)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz(6)
  digest         String

  @@id([organization, login, observedAt])
  @@map("org_people")
}

/// What the ownership ladder decided, and which rung decided it.
///
/// SEVERAL ROWS PER REPOSITORY IS THE NORMAL CASE, not an exception: a repository two teams hold `admin`
/// on has two owners, and collapsing that to one would invent a tie-break nobody made. `owner_kind` is
/// part of the key because a team and a person may share a handle and are not the same owner.
///
/// `owner_kind = 'none'` is a REMEMBERED NEGATIVE in exactly the sense `sonar_project_map` uses the
/// phrase: the ladder was walked, every rung declined, and the answer is stored so that "how many
/// repositories does nobody own" is one COUNT rather than a set difference somebody has to remember to
/// compute — and so that "nothing owns it" stays distinguishable from "we never looked". The
/// `("owner_kind" = 'none') = ("owner" = '')` CHECK constraint in the org-graph migration is what keeps
/// that row from being confused with one somebody half-wrote.
///
/// NO SECONDARY INDEX ON `rung`, for the reason `OrgTeamMembership` states about its own. Counting the
/// attributions by confidence — `name-prefix` is a guess and `teams-api-admin` is nearly a declaration — is
/// a report nothing assembles, and `liveRepositoryOwnership` reads the whole organisation through the
/// `_live` partial unique.
model RepositoryOwnership {
  organization   String
  repository     String
  /// `team`, `person`, or `none` — see `OwnerKind` in org/graph.ts.
  ownerKind      String    @map("owner_kind")
  /// A team slug, a login, or `''` when `owner_kind` is `none`.
  owner          String
  /// Which rung attributed it — see `OwnershipRung`. Stored so a reader can weigh the answer.
  rung           String
  payload        Json      @db.JsonB
  observedAt     DateTime  @map("observed_at") @db.Timestamptz(6)
  lastObservedAt DateTime  @map("last_observed_at") @db.Timestamptz(6)
  supersededAt   DateTime? @map("superseded_at") @db.Timestamptz(6)
  digest         String

  @@id([organization, repository, ownerKind, owner, observedAt])
  @@map("repository_ownership")
}
